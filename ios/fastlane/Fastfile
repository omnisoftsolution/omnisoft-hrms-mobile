# Fastlane lanes for Omni HR iOS releases.
#
# Usage from omnisoft-hrms-mobile/ios/:
#
#   fastlane beta          — flutter build + archive + IPA export + TestFlight upload
#   fastlane archive_only  — produce a signed IPA, no upload (for sanity / re-trying upload)
#
# Requires:
#   - Xcode signing already working interactively (cert + provisioning
#     profile for com.omnisoftsolution.omnihr present in the
#     login keychain — the manual Organizer flow already proves this).
#   - App Store Connect API key JSON at the path baked into ASC_API_KEY
#     below (lives in ~/Keys/, OUTSIDE the repo).
#   - pubspec.yaml version bumped before invoking.

default_platform(:ios)

# App Store Connect API key — referenced both by xcodebuild auth
# flags (xcargs) and by the app_store_connect_api_key fastlane
# action (which puts it into shared lane context for downstream
# upload_to_testflight). The .p8 + IDs are the source of truth — no
# JSON wrapper needed because the canonical wrapper format
# (`spaceship` `from_json_file`) requires the PEM contents inline,
# which duplicates the .p8 and adds nothing.
ASC_KEY_P8    = "/Users/willytanuwiharja/Keys/AuthKey_2XPKCNK756.p8"
ASC_KEY_ID    = "2XPKCNK756"
ASC_ISSUER_ID = "286884df-f1cf-44b8-a635-1cf724fc7ec6"

# Flags that let xcodebuild authenticate signing operations against
# Apple Developer portal directly (Xcode 13+). Without these,
# `xcodebuild -exportArchive` fails with "No Accounts / No signing
# certificate iOS Distribution found" because Xcode 26's
# cloud-managed dist certs aren't in the login keychain that the
# CLI sees.
ASC_AUTH_FLAGS = "-allowProvisioningUpdates " \
                 "-authenticationKeyPath #{ASC_KEY_P8} " \
                 "-authenticationKeyID #{ASC_KEY_ID} " \
                 "-authenticationKeyIssuerID #{ASC_ISSUER_ID}"

# Where build_app drops the signed IPA. Relative to ios/.
IPA_OUTPUT_DIR  = "../build/ios/fastlane"
IPA_OUTPUT_NAME = "omnihr.ipa"

# TestFlight "What to Test" notes, attached to every beta upload. Edit
# this per release. Inlined (not read from a file) so it can't break on a
# path/cwd surprise during the upload step. TestFlight allows ~4000 chars.
TESTFLIGHT_CHANGELOG = <<~NOTES.freeze
  Face ID / Touch ID sign-in on the login screen.

  New:
  - Your Face ID login is now remembered across Log out. After you log out,
    the login screen shows a "Sign in with Face ID / Touch ID" button under
    SIGN IN, so you can sign back in without typing your password.
  - Face ID also prompts automatically when you return to the app.

  Please test:
  1. Enable Face ID login (Profile > Security & Privacy).
  2. Tap Log out. On the login screen you should see a "Sign in with Face ID"
     button under SIGN IN, and NO automatic Face ID popup right after logout.
  3. Tap that button (or close and reopen the app) to sign in with Face ID.
  4. Delete account still requires your password (no Face ID button).

  Also in this build: the Security & Privacy card on Profile (from build 73).
NOTES

platform :ios do
  desc "Build & ship to TestFlight in one shot"
  lane :beta do
    asc_api_key_setup
    flutter_prebuild
    archive_and_export
    upload_to_testflight(
      ipa: "#{IPA_OUTPUT_DIR}/#{IPA_OUTPUT_NAME}",
      # "What to Test" shown to internal testers (see TESTFLIGHT_CHANGELOG).
      changelog: TESTFLIGHT_CHANGELOG,
      # Don't wait for Apple's processing to finish — uploads land in
      # TestFlight as "Processing" within ~1 min, then become available
      # to testers within ~10. Blocking here just makes fastlane sit
      # idle.
      skip_waiting_for_build_processing: true,
      # We're going to internal testers only — never auto-submit for
      # external review.
      skip_submission: true,
    )
  end

  desc "Upload the already-built IPA to TestFlight (no rebuild)"
  lane :upload_only do
    asc_api_key_setup
    upload_to_testflight(
      ipa: "#{IPA_OUTPUT_DIR}/#{IPA_OUTPUT_NAME}",
      changelog: TESTFLIGHT_CHANGELOG,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end

  desc "Archive + export IPA only (no upload). Useful for re-trying upload separately."
  lane :archive_only do
    flutter_prebuild
    archive_and_export
    UI.message("✓ IPA ready at #{IPA_OUTPUT_DIR}/#{IPA_OUTPUT_NAME}")
  end

  # --- Helpers ----------------------------------------------------

  # Set the App Store Connect API key once, into Fastlane's shared
  # lane context. Downstream actions (upload_to_testflight, deliver,
  # pilot) pick it up automatically — no need to thread `api_key`
  # through every call. This action accepts `key_filepath`, unlike
  # the older JSON-file path which requires the PEM contents inline.
  def asc_api_key_setup
    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_P8,
      in_house: false,
    )
  end

  # `flutter build ios --release --no-codesign` regenerates
  # ios/Flutter/Generated.xcconfig with the current
  # FLUTTER_BUILD_NUMBER from pubspec.yaml. Without this, xcodebuild
  # reads the stale cached build number and ships v<N-1>. Bug pattern
  # documented in memory `ios-archive-workflow`.
  #
  # Before that, run `tools/patch_tflite_pod.sh` so the bundled
  # tflite_flutter package gets pinned to TFLite 2.17.0 instead of
  # the upstream 2.12.0 (which can't load our ai_edge_torch-converted
  # spoof models). The script is idempotent.
  def flutter_prebuild
    # Homebrew's fastlane runs under its own Ruby and exports
    # GEM_HOME/GEM_PATH pointing at that Ruby's gem dir. Those leak into
    # this `sh` subprocess and break Homebrew CocoaPods — `pod` then looks
    # for its gems (minitest, activesupport, …) under the wrong Ruby and
    # raises Gem::MissingSpecError, so flutter reports "CocoaPods not
    # installed or not in valid state" and skips `pod install`, failing the
    # build. Strip the gem/bundler env so flutter+pod run in the same clean
    # environment a normal login shell has (where `flutter doctor` is green).
    clean_env = 'env -u GEM_HOME -u GEM_PATH -u RUBYOPT -u RUBYLIB ' \
                '-u BUNDLE_GEMFILE -u BUNDLE_BIN_PATH -u BUNDLE_PATH'
    sh("cd ../.. && #{clean_env} tools/patch_tflite_pod.sh && #{clean_env} flutter build ios --release --no-codesign")
  end

  # Build (archive) + export the IPA in a single xcodebuild
  # invocation. Xcode 26 stores distribution certs as cloud-managed
  # identities that aren't in the login keychain. Passing
  # `api_key_path` tells gym to authenticate signing operations
  # against Apple's portal — xcodebuild then fetches the cert
  # on-the-fly (same path Organizer uses, but driven from CLI).
  def archive_and_export
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: "5PBHZ3JDAD",
      },
      output_directory: IPA_OUTPUT_DIR,
      output_name: IPA_OUTPUT_NAME,
      include_symbols: true,
      include_bitcode: false,
      clean: false,
      # Archive step only needs provisioning updates. The auth
      # flags must go on export only — xcodebuild rejects a second
      # `-authenticationKeyPath` if we also passed it here.
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: ASC_AUTH_FLAGS,
    )
  end
end
