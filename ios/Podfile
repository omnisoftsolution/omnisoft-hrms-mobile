# google_mlkit_face_detection 0.13 / google_mlkit_commons require iOS 15.5+.
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # NOTE: tflite_flutter 0.12.1's podspec is locally patched to pin
  # TensorFlowLite{Swift,C} to 2.17.0 instead of the upstream 2.12.0.
  # The patch lives at
  # ~/.pub-cache/hosted/pub.dev/tflite_flutter-0.12.1/ios/tflite_flutter.podspec
  # — a `tflite_version = '2.17.0'` line. Reason: TFLite 2.12 (April
  # 2023) predates Google's `ai_edge_torch` PyTorch→TFLite converter
  # (2024+), and our spoof models from that converter contain int64
  # padding tensors + bool intermediates the 2.12 interpreter can't
  # allocate ("Failed to allocate memory for input tensors"). The
  # patch will be reapplied automatically by tools/patch_tflite_pod.sh
  # on each `flutter pub get` (see Fastfile pre-hooks). New devs
  # cloning the repo: run that script once before `pod install`.
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Force every pod target up to 15.5 so individual pods (like
      # GoogleMLKit) don't get installed with a lower target that
      # then fails to link.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'

      # MLKitFaceDetection's iOS pod ships without arm64-simulator
      # slices, so we exclude arm64 from simulator builds and let
      # Xcode run the x86_64 slice under Rosetta. This requires an
      # iOS 17 or 18 simulator runtime — iOS 26+ simulators on
      # Apple Silicon refuse to launch x86_64 / Rosetta builds.
      # Real iPhone / iPad builds are unaffected.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end

  # KNOWN ISSUE — iOS face match (tflite_flutter) fails on Xcode 26
  # release builds with "dlsym(RTLD_DEFAULT, ...): symbol not found"
  # because Apple's linker strips the TFLite C symbols that dart:ffi
  # looks up at runtime. We tried 9 documented workarounds (
  # -force_load, -all_load, Swift @_silgen_name, C __attribute__((used)),
  # C __attribute__((constructor)), upgrading tflite_flutter to 0.12.1)
  # — every approach was dead-stripped at link time. Needs deeper
  # investigation (ld -why_live, upstream tflite_flutter issue).
  # Until then, the mobile app uses DevConstants.simulateFaceRecognition
  # on iOS only — see lib/core/constants.dart. Android works fine.
  #
  # The defensive OTHER_LDFLAGS cleanup below clears any stale
  # -force_load / -all_load entries left in project.pbxproj from
  # earlier debugging — prevents pod-install surprises.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      next unless target.name == 'Runner'
      target.build_configurations.each do |config|
        config.build_settings['OTHER_LDFLAGS'] = '$(inherited)'
        config.build_settings.delete('OTHER_LDFLAGS[sdk=iphoneos*]')
        config.build_settings.delete('OTHER_LDFLAGS[sdk=iphonesimulator*]')
      end
    end
    aggregate_target.user_project.save
  end
end
